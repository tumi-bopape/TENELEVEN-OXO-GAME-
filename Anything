    def grid_button_clicked(self, position):
        """Sends move to server when a grid button is pressed"""
        if not self.connected:
            self.statusbar.setText("Not connected to server!")
            return

        # Only send if the local board thinks the spot is empty
        if self.board[position] == ' ':
            # We send the move to the server
            # The server will reply with 'valid move' which triggers the GUI update
            self.send_message(f"move,{position}")
            self.serveroutput.setText(f"Sent move to position {position}...")
        
    def new_game_button_clicked(self):
        """Request a new game"""
        self.send_message("y")
        self.waiting_for_restart = True
        self.serveroutput.setText("Requesting new game...")
    
    def connect_button_clicked(self):
        """Connect to server and start the background listener"""
        self.IP = self.enterserver.text()
        
        # 1. Update status so user knows we are trying
        self.statusbar.setText(f"Connecting to {self.IP}...")
        self.statusbar.setStyleSheet("color: yellow;")
        
        try:
            # 2. Attempt connection
            self.connect_to_server(self.IP)
            
            # 3. Force the connection flag to True
            self.connected = True 
            
            # 4. UI Updates
            self.statusbar.setText("Connected! Waiting for game...")
            self.statusbar.setStyleSheet("background-color: #002147; color: #00FF00;")
            self.serverbutton.setEnabled(False)
            self.enterserver.setEnabled(False)
            
            # 5. Start the background thread
            self.thread = threading.Thread(target=self.play_loop, daemon=True)
            self.thread.start()
            
        except Exception as e:
            self.connected = False
            self.statusbar.setText("Connection failed!")
            self.statusbar.setStyleSheet("background-color: #002147; color: #FF3131;")
            print(f"Connect Error: {e}")
    def restart_button_clicked(self):
        """Clear the local board"""
        self.clear_board()
        self.serveroutput.setText("Board cleared locally")
    
    def cancel_clicked(self):
        """Exit the game"""
        if self.connected:
            self.close_connection()
        self.close()
    
    def clear_board(self):
        """Clear the game board"""
        self.board = [' '] * BOARD_SIZE
        for i in range(3):
            for j in range(3):
                self.buttons[i][j].setText("")
                self.buttons[i][j].setStyleSheet("background-color: #002147; color: white; font-size: 32px;")
    
    def display_on_board(self):
        """Update the GUI board"""
        for i in range(3):
            for j in range(3):
                pos = i * 3 + j
                if self.board[pos] != ' ':
                    self.buttons[i][j].setText(self.board[pos])
                    if self.board[pos] == 'X':
                        self.buttons[i][j].setStyleSheet("background-color: #002147; color: #FF3131; font-size: 32px; font-weight: bold;")
                    else:
                        self.buttons[i][j].setStyleSheet("background-color: #002147; color: #2323FF; font-size: 32px; font-weight: bold;")
    
    def input_move(self):
        """This is called from handle_message - but we use GUI buttons instead"""
        # Return a placeholder - actual moves come from button clicks
        return ""
    
    def input_play_again(self):
        """Ask user if they want to play again"""
        reply = QMessageBox.question(self, 'Play Again?', 
                                     'Game Over! Would you like to play again?',
                                     QMessageBox.Yes | QMessageBox.No,
                                     QMessageBox.Yes)
        return 'y' if reply == QMessageBox.Yes else 'n'
    
    def handle_message(self, msg):
            """Processes messages and updates the GUI elements"""
            # 1. Always show the raw message in the blue box
            self.serveroutput.setText(msg)
            
            # 2. Logic to update the board and labels
            if msg.startswith('new game,'):
                self.shape = msg.split(',')[1]
                self.clear_board()
                self.statusbar.setText(f"Connected - Playing as {self.shape}")
                self.info.setText("Game Started! New board ready.")
                
            elif msg.startswith('your move'):
                self.info.setText("IT IS YOUR TURN!")
                self.info.setStyleSheet("color: #00FF00; font-size: 14px; font-weight: bold;")
                
            elif msg.startswith('opponents move'):
                self.info.setText("Waiting for opponent...")
                self.info.setStyleSheet("color: white; font-size: 12px;")
                
            elif msg.startswith('valid move,'):
                # Format: valid move,X,4
                _, shape, pos = msg.split(',')
                self.board[int(pos)] = shape
                self.display_on_board()
                
            elif msg.startswith('invalid move'):
                self.info.setText("That spot is taken! Try again.")
                self.info.setStyleSheet("color: #FF3131; font-size: 12px;")
    
            elif msg.startswith('game over,'):
                winner = msg.split(',')[1]
                self.process_game_over(winner)
    def play_loop(self):
        self.connected = True # Ensure this is true so the loop starts
        while self.connected:
            try:
                msg = self.receive_message()
                if msg:
                    # In some socket setups, msg is already a string
                    # In others, it's bytes. If you get a TypeError, use: 
                    # self.buffer += msg.decode() 
                    self.buffer += msg
                    
                    # Process every complete message ending in newline
                    while '\n' in self.buffer:
                        full_msg, self.buffer = self.buffer.split('\n', 1)
                        full_msg = full_msg.strip()
                        if full_msg:
                            # This sends the message to handle_message safely
                            self.message_received.emit(full_msg)
                else:
                    # Server closed connection
                    self.connected = False
                    self.message_received.emit("exit game")
                    break
            except Exception as e:
                print(f"Receive Error: {e}")
                self.connected = False
                break

def main():
    app = QApplication(sys.argv)
    game = OXOGUIClient()
    game.show()
    sys.exit(app.exec_())

if __name__ == "__main__":
    main()
