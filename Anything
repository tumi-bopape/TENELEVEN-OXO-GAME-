from GameClient import *
import sys, random
from PyQt5.QtWidgets import *
from PyQt5.QtGui import *
from PyQt5.QtCore import Qt, pyqtSignal
import threading


class OXOGUIClient(GameClient, QWidget):
    message_received = pyqtSignal(str)

    def __init__(self):

        GameClient.__init__(self)
        QWidget.__init__(self)

        self.message_received.connect(self.handle_message)

        self.board = [' '] * BOARD_SIZE
        self.shape = None
        self.buffer = ""
        self.current_move = None
        self.waiting_for_move = False
        self.waiting_play_again = False

        self.buttons = []

        self.setWindowTitle("Ten Eleven Games")
        self.setGeometry(250, 50, 700, 500)

        # ---------------- Labels ----------------
        self.title_label1 = QLabel("ULTIMATE", self)
        self.title_label1.setFont(QFont("Orbitron", 28, QFont.Bold))
        self.title_label1.setStyleSheet("color:white;")

        self.oxo_label = QLabel(
            "<span style='color:#2323FF;'>----- O </span>"
            "<span style='color:#FF3131;'>X</span>"
            "<span style='color:#2323FF;'> O -----</span>"
        )
        self.oxo_label.setFont(QFont("Montserrat", 15, QFont.Bold))
        self.oxo_label.setAlignment(Qt.AlignCenter)

        self.slogan = QLabel("The Ultimate Tic-Tac-Toe Experience!")
        self.slogan.setStyleSheet("color:white;")

        self.info = QLabel("Click CONNECT to start")
        self.info.setStyleSheet("color:white;")

        self.info2 = QLabel("Example: 127.0.0.1")
        self.info2.setStyleSheet("color:white;")

        self.status_label = QLabel("Status:")
        self.status_label.setStyleSheet("color:white;")

        self.server_label = QLabel("Enter server:")
        self.server_label.setStyleSheet("color:white;")

        self.statusbar = QLabel("")
        self.statusbar.setStyleSheet(
            "background-color:#002147;color:white;padding:4px;"
        )

        self.serveroutput = QLabel("")
        self.serveroutput.setStyleSheet(
            "background-color:#002147;color:white;padding:4px;"
        )

        # ---------------- Buttons ----------------
        self.closebutton = QPushButton("EXIT")
        self.closebutton.clicked.connect(self.cancel_clicked)

        self.newgamebutton = QPushButton("NEW GAME")
        self.newgamebutton.clicked.connect(self.new_game_button_clicked)

        self.serverbutton = QPushButton("CONNECT")
        self.serverbutton.clicked.connect(self.connect_button_clicked)

        self.restartbutton = QPushButton("RESTART")
        self.restartbutton.clicked.connect(self.restart_button_clicked)

        # ---------------- Input ----------------
        self.enterserver = QLineEdit()
        self.enterserver.setText("127.0.0.1")

        # ---------------- Board ----------------
        board_grid = QGridLayout()

        for i in range(3):
            for j in range(3):
                btn = QPushButton("")
                btn.setFixedSize(100, 100)
                btn.setFont(QFont("Arial", 28, QFont.Bold))
                btn.setStyleSheet("background-color:white;")
                btn.clicked.connect(self.grid_button_clicked)
                self.buttons.append(btn)
                board_grid.addWidget(btn, i, j)

        board_widget = QWidget()
        board_widget.setLayout(board_grid)

        # ---------------- Left Layout ----------------
        left = QVBoxLayout()
        left.addWidget(self.title_label1)
        left.addWidget(self.oxo_label)
        left.addWidget(self.slogan)
        left.addWidget(self.status_label)
        left.addWidget(self.statusbar)
        left.addWidget(board_widget)
        left.addWidget(self.info)

        # ---------------- Right Layout ----------------
        right = QVBoxLayout()
        right.addWidget(self.server_label)
        right.addWidget(self.enterserver)
        right.addWidget(self.serverbutton)
        right.addWidget(self.info2)
        right.addSpacing(20)
        right.addWidget(QLabel("Messages:"))
        right.addWidget(self.serveroutput)
        right.addStretch()

        # ---------------- Top Layout ----------------
        top = QHBoxLayout()
        top.addLayout(left)
        top.addLayout(right)

        # ---------------- Bottom Buttons ----------------
        bottom = QHBoxLayout()
        bottom.addWidget(self.newgamebutton)
        bottom.addWidget(self.restartbutton)
        bottom.addWidget(self.closebutton)

        # ---------------- Main Layout ----------------
        main = QVBoxLayout()
        main.addLayout(top)
        main.addLayout(bottom)

        self.setLayout(main)
        self.setStyleSheet("background-color:#003153;")

    # =====================================================
    # BUTTON CLICKED
    # =====================================================

    def grid_button_clicked(self):
        if not self.waiting_for_move:
            return

        button = self.sender()
        index = self.buttons.index(button)

        if self.board[index] == ' ':
            self.current_move = str(index)
            self.waiting_for_move = False

    def new_game_button_clicked(self):
        try:
            self.send_message("y")
        except:
            pass

    def connect_button_clicked(self):
        ip = self.enterserver.text()

        try:
            self.statusbar.setText("Connecting...")
            self.connect_to_server(ip)

            self.thread = threading.Thread(
                target=self.play_loop,
                daemon=True
            )
            self.thread.start()

            self.statusbar.setText("Connected!")

        except Exception as e:
            self.statusbar.setText("Connection Failed")

    def restart_button_clicked(self):
        self.clear_board()
        self.display_on_board()

    def cancel_clicked(self):
        self.close()

    # =====================================================
    # BOARD
    # =====================================================

    def clear_board(self):
        self.board = [' '] * BOARD_SIZE

    def display_on_board(self):

        for i in range(BOARD_SIZE):

            if self.board[i] == 'X':
                self.buttons[i].setText("X")
                self.buttons[i].setStyleSheet(
                    "background:white;color:red;font-size:28px;"
                )

            elif self.board[i] == 'O':
                self.buttons[i].setText("O")
                self.buttons[i].setStyleSheet(
                    "background:white;color:blue;font-size:28px;"
                )

            else:
                self.buttons[i].setText("")
                self.buttons[i].setStyleSheet(
                    "background:white;"
                )

    # =====================================================
    # INPUT METHODS
    # =====================================================

    def input_move(self):

        self.waiting_for_move = True
        self.current_move = None

        while self.current_move is None:
            QApplication.processEvents()

        return self.current_move

    def input_play_again(self):

        reply = QMessageBox.question(
            self,
            "Play Again",
            "Would you like to play again?",
            QMessageBox.Yes | QMessageBox.No
        )

        if reply == QMessageBox.Yes:
            return 'y'
        return 'n'

    # =====================================================
    # HANDLE SERVER MESSAGE
    # =====================================================

    def handle_message(self, msg):

        self.serveroutput.setText(msg)

        if msg.startswith("new game,"):

            self.shape = msg.split(",")[1]
            self.clear_board()
            self.display_on_board()

            self.statusbar.setText(f"Playing as {self.shape}")
            self.info.setText("Game Started")

        elif msg.startswith("your move"):

            self.info.setText("Your Turn")
            move = self.input_move()
            self.send_message(move)

        elif msg.startswith("opponents move"):

            self.info.setText("Opponent Turn")

        elif msg.startswith("invalid move"):

            self.info.setText("Invalid Move")

        elif msg.startswith("valid move,"):

            parts = msg.split(",")

            shape = parts[1]
            position = int(parts[2])

            self.board[position] = shape
            self.display_on_board()

        elif msg.startswith("game over,"):

            winner = msg.split(",")[1]

            if winner == self.shape:
                self.info.setText("YOU WON!")

            elif winner == "tie":
                self.info.setText("DRAW!")

            else:
                self.info.setText("YOU LOST!")

        elif msg == "play again":

            answer = self.input_play_again()
            self.send_message(answer)

        elif msg == "exit game":

            self.statusbar.setText("Disconnected")
            self.socket.close()

    # =====================================================
    # THREAD LOOP
    # =====================================================

    def play_loop(self):

        while True:

            try:
                msg = self.receive_message()

                if not msg:
                    break

                self.buffer += msg

                while '\n' in self.buffer:
                    full_msg, self.buffer = self.buffer.split('\n', 1)
                    self.message_received.emit(full_msg)

            except:
                break


# =====================================================
# MAIN
# =====================================================

def main():
    app = QApplication(sys.argv)
    game = OXOGUIClient()
    game.show()
    sys.exit(app.exec_())


main()
