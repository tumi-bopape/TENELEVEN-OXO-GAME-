import sys
import threading
from PyQt5.QtWidgets import *
from PyQt5.QtGui import *
from PyQt5.QtCore import Qt, pyqtSignal
from GameClient import *

# Assuming BOARD_SIZE is defined in GameClient, usually 9
BOARD_SIZE = 9

class OXOGUIClient(GameClient, QWidget):
    # Signal to safely pass messages from the background thread to the UI thread
    message_received = pyqtSignal(str)

    def __init__(self):
        GameClient.__init__(self)
        QWidget.__init__(self)
        
        self.board = [' '] * BOARD_SIZE
        self.shape = None
        self.buffer = ""
        self.my_turn = False
        self.buttons = [] # To keep track of the 9 grid buttons
        
        self.init_ui()
        self.message_received.connect(self.handle_message)

    def init_ui(self):
        self.setWindowTitle("Ten Eleven Games")
        self.setFixedSize(600, 500)
        
        # --- Left Panel: Game Board & Titles ---
        vbox_left = QVBoxLayout()
        
        self.title_label1 = QLabel("ULTIMATE")
        self.title_label1.setFont(QFont("Orbitron", 28, QFont.Bold))
        self.title_label1.setStyleSheet("color: white;")
        self.title_label1.setAlignment(Qt.AlignCenter)

        self.oxo_label = QLabel(
            "<span style='color:#2323FF;'>----- O </span>"
            "<span style='color:#FF3131;'>X</span>"
            "<span style='color:#2323FF;'> O -----</span>"
        )
        self.oxo_label.setFont(QFont("Montserrat", 15, QFont.Bold))
        self.oxo_label.setAlignment(Qt.AlignCenter)

        # The Grid
        grid_layout = QGridLayout()
        grid_layout.setSpacing(5)
        for i in range(9):
            btn = QPushButton("")
            btn.setFixedSize(80, 80)
            btn.setFont(QFont("Arial", 24, QFont.Bold))
            btn.setStyleSheet("background-color:#002147; color: white; border: 1px solid #003153;")
            # Use a default argument in lambda to capture the current value of i
            btn.clicked.connect(lambda checked, idx=i: self.grid_button_clicked(idx))
            grid_layout.addWidget(btn, i // 3, i % 3)
            self.buttons.append(btn)
        
        self.info = QLabel("Connect to a server to start!")
        self.info.setStyleSheet("color: white;")
        self.info.setAlignment(Qt.AlignCenter)

        vbox_left.addWidget(self.title_label1)
        vbox_left.addWidget(self.oxo_label)
        vbox_left.addLayout(grid_layout)
        vbox_left.addWidget(self.info)

        # --- Right Panel: Server & Status ---
        vbox_right = QVBoxLayout()
        vbox_right.setContentsMargins(10, 10, 10, 10)

        # Server Connection Group
        self.server_label = QLabel("Enter Server IP:")
        self.server_label.setStyleSheet("color: white; font-weight: bold;")
        self.enterserver = QLineEdit()
        self.enterserver.setPlaceholderText("127.0.0.1")
        self.enterserver.setStyleSheet("background-color:#002147; color: white; padding: 5px;")
        
        self.serverbutton = QPushButton("CONNECT")
        self.serverbutton.clicked.connect(self.connect_button_clicked)
        self.serverbutton.setStyleSheet("background-color: blue; color: white; font-weight: bold;")

        # Status Group
        self.game_messages = QLabel("Game Messages:")
        self.game_messages.setStyleSheet("color: white; font-weight: bold;")
        self.serveroutput = QLabel("No connection")
        self.serveroutput.setWordWrap(True)
        self.serveroutput.setStyleSheet("background-color:#002147; color: #00FF00; padding: 5px;")
        self.serveroutput.setMinimumHeight(50)

        self.statusbar = QLabel("Status: Idle")
        self.statusbar.setStyleSheet("background-color:#002147; color: white; padding: 5px;")

        vbox_right.addWidget(self.server_label)
        vbox_right.addWidget(self.enterserver)
        vbox_right.addWidget(self.serverbutton)
        vbox_right.addSpacing(20)
        vbox_right.addWidget(self.game_messages)
        vbox_right.addWidget(self.serveroutput)
        vbox_right.addWidget(self.statusbar)
        vbox_right.addStretch()

        # --- Bottom Panel: Controls ---
        hbox_bottom = QHBoxLayout()
        self.newgamebutton = QPushButton("NEW GAME")
        self.restartbutton = QPushButton("RESTART")
        self.closebutton = QPushButton("EXIT")
        
        self.closebutton.clicked.connect(self.close)
        self.newgamebutton.setStyleSheet("background-color: green; color: white;")
        self.closebutton.setStyleSheet("background-color: red; color: white;")

        hbox_bottom.addWidget(self.newgamebutton)
        hbox_bottom.addWidget(self.restartbutton)
        hbox_bottom.addWidget(self.closebutton)

        # --- Layout Assembly ---
        main_layout = QVBoxLayout()
        
        top_hbox = QHBoxLayout()
        left_widget = QWidget()
        left_widget.setLayout(vbox_left)
        right_widget = QWidget()
        right_widget.setLayout(vbox_right)
        right_widget.setFixedWidth(220)
        
        top_hbox.addWidget(left_widget)
        top_hbox.addWidget(right_widget)
        
        main_layout.addLayout(top_hbox)
        main_layout.addLayout(hbox_bottom)
        
        self.setLayout(main_layout)
        self.setStyleSheet("background-color: #001a33;")

    # --- Logic Methods ---

    def grid_button_clicked(self, index):
        if self.my_turn:
            if self.board[index] == ' ':
                self.send_message(str(index))
                self.my_turn = False
                self.info.setText("Message sent. Waiting for server...")
            else:
                self.info.setText("Cell already taken!")
        else:
            self.info.setText("Wait for your turn!")

    def connect_button_clicked(self):
        ip = self.enterserver.text() or "127.0.0.1"
        try:
            self.connect_to_server(ip)
            self.statusbar.setText("Connected!")
            self.serverbutton.setEnabled(False)
            # Start background thread to listen for server messages
            self.thread = threading.Thread(target=self.play_loop, daemon=True)
            self.thread.start()
        except Exception as e:
            self.statusbar.setText("Connection failed.")
            print(f"Connection Error: {e}")

    def display_on_board(self):
        for i, char in enumerate(self.board):
            self.buttons[i].setText(char)
            # Change color based on X or O
            if char == 'X':
                self.buttons[i].setStyleSheet("background-color:#002147; color: #FF3131; font-weight: bold;")
            elif char == 'O':
                self.buttons[i].setStyleSheet("background-color:#002147; color: #2323FF; font-weight: bold;")
            else:
                self.buttons[i].setStyleSheet("background-color:#002147; color: white;")

    def clear_board(self):
        self.board = [' '] * BOARD_SIZE
        self.display_on_board()

    def handle_message(self, msg):
        msg = msg.strip()
        self.serveroutput.setText(msg)
        
        if msg.startswith('new game,'):
            self.shape = msg.split(',')[1]
            self.clear_board()
            self.statusbar.setText(f"Playing as: {self.shape}")
            self.info.setText("New game started!")
           
        elif msg == 'your move':
            self.info.setText("YOUR TURN!")
            self.my_turn = True
        
        elif msg == 'opponents move':
            self.info.setText("Opponent is thinking...")
            self.my_turn = False
        
        elif msg.startswith('valid move,'):
            parts = msg.split(',')
            shape = parts[1]
            pos = int(parts[2])
            self.board[pos] = shape
            self.display_on_board()
        
        elif msg.startswith('invalid move'):
            self.info.setText("Invalid move! Try again.")
            self.my_turn = True
        
        elif msg.startswith('game over,'):
            winner = msg.split(',')[1]
            if winner == self.shape:
                self.info.setText(" YOU WON!")
            elif winner == 'tie':
                self.info.setText(" IT'S A TIE!")
            else:
                self.info.setText(" YOU LOST!")
            self.my_turn = False

    def play_loop(self):
        """Background thread that listens for raw data from the server."""
        while True:
            try:
                data = self.receive_message()
                if not data:
                    break
                
                self.buffer += data
                while '\n' in self.buffer:
                    line, self.buffer = self.buffer.split('\n', 1)
                    if line.strip():
                        # Use signal to update UI from background thread
                        self.message_received.emit(line)
            except Exception as e:
                print(f"Network error: {e}")
                break

def main():
    app = QApplication(sys.argv)
    client = OXOGUIClient()
    client.show()
    sys.exit(app.exec_())

if __name__ == "__main__":
    main()
