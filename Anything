import sys
from PyQt5.QtWidgets import *
from PyQt5.QtGui import *
from PyQt5.QtCore import Qt, QTimer
from GameClient import * # Uses send_message, receive_message, connect_to_server
from GameIni import *

class TicTacToe(QWidget, GameClient):
    def __init__(self):
        # Initialize both parent classes
        QWidget.__init__(self)
        GameClient.__init__(self)
        
        self.current_theme = "dark"
        self.shape = None  # Assigned by server ('X' or 'O')
        self.board = [' '] * BOARD_SIZE
        
        # Setup Timer to check for server messages every 100ms
        self.network_timer = QTimer()
        self.network_timer.timeout.connect(self.check_network)
        
        self.init_ui()
        self.apply_theme()

    def init_ui(self):
        self.setWindowTitle("Ten Eleven OXO Game - Ultimate Edition")
        self.setGeometry(250, 250, 900, 600)

        # Labels & Headers
        self.title_label1 = QLabel("ULTIMATE", self)  
        self.title_label1.setFont(QFont("Orbitron", 28, QFont.Bold))
        
        self.oxo_label = QLabel(
            "<span style='color:#2323FF;'>----- O </span>"
            "<span style='color:#FF3131;'>X</span>"
            "<span style='color:#2323FF;'> O -----</span>"
        )
        self.oxo_label.setFont(QFont("Montserrat", 15, QFont.Bold))
        self.oxo_label.setAlignment(Qt.AlignCenter)        
        
        self.slogan = QLabel("The Ultimate Tic-Tac-Toe Experience!")
        self.slogan.setFont(QFont("Orbitron", 8, QFont.Bold))
        
        self.status_label = QLabel("Current Status:", self)
        self.status_label.setFont(QFont("Orbitron", 8, QFont.Bold))
        self.statusbar = QLabel("Disconnected. Please enter server IP.", self)

        # Networking Section
        self.enterserver = QLineEdit(self)
        self.enterserver.setPlaceholderText("e.g. 127.0.0.1")
        self.serverbutton = QPushButton("CONNECT", self)
        self.serverbutton.clicked.connect(self.connect_button_clicked)
        
        # Game Info Panel
        self.game_messages = QLabel("Game Logs:")
        self.serveroutput = QLabel("Welcome! Ready to play.", self)
        self.player1_lbl = QLabel("Player 1: (X)", self)
        self.player2_lbl = QLabel("Player 2: (O)", self)

        # The Game Board
        self.board_buttons = []
        cross_grid = QGridLayout()
        cross_grid.setSpacing(10)
        for i in range(3):
            row = []
            for j in range(3):
                btn = QPushButton("")
                btn.setFixedSize(100, 100)
                btn.setFont(QFont("Arial", 24, QFont.Bold))
                btn.setEnabled(False) # Wait for game start
                btn.clicked.connect(self.grid_button_clicked)
                cross_grid.addWidget(btn, i, j)
                row.append(btn)
            self.board_buttons.append(row)

        # Control Buttons
        self.newgamebutton = QPushButton("NEW GAME", self)
        self.newgamebutton.clicked.connect(self.new_game_clicked)
        
        self.restartbutton = QPushButton("RESTART", self)
        self.restartbutton.clicked.connect(self.restart_clicked)
        
        self.helpbutton = QPushButton("HELP", self)
        self.helpbutton.clicked.connect(self.show_help_screen)
        
        self.themebutton = QPushButton("SWITCH THEME", self)
        self.themebutton.clicked.connect(self.switch_theme)

        self.closebutton = QPushButton("EXIT", self) 
        self.closebutton.clicked.connect(self.close)

        # Layout Arrangement
        left_panel = QVBoxLayout()
        left_panel.addWidget(self.title_label1)
        left_panel.addWidget(self.oxo_label)
        left_panel.addWidget(self.slogan)
        
        status_box = QHBoxLayout()
        status_box.addWidget(self.status_label)
        status_box.addWidget(self.statusbar)
        left_panel.addLayout(status_box)
        left_panel.addLayout(cross_grid)

        right_panel = QVBoxLayout()
        right_panel.addWidget(QLabel("<b>Server Address:</b>"))
        right_panel.addWidget(self.enterserver)
        right_panel.addWidget(self.serverbutton)
        right_panel.addSpacing(30)
        right_panel.addWidget(QLabel("<b>Players:</b>"))
        right_panel.addWidget(self.player1_lbl)
        right_panel.addWidget(self.player2_lbl)
        right_panel.addSpacing(30)
        right_panel.addWidget(self.game_messages)
        right_panel.addWidget(self.serveroutput)
        right_panel.addStretch()

        main_layout = QHBoxLayout()
        main_layout.addLayout(left_panel, 2)
        main_layout.addLayout(right_panel, 1)

        bottom_buttons = QHBoxLayout()
        bottom_buttons.addWidget(self.newgamebutton)
        bottom_buttons.addWidget(self.restartbutton)
        bottom_buttons.addWidget(self.helpbutton)
        bottom_buttons.addWidget(self.themebutton)
        bottom_buttons.addWidget(self.closebutton)

        final_layout = QVBoxLayout()
        final_layout.addLayout(main_layout)
        final_layout.addLayout(bottom_buttons)
        self.setLayout(final_layout)

    # --- NETWORK LOGIC ---
    def check_network(self):
        """Polls the server for updates without blocking the UI"""
        try:
            self.socket.setblocking(False)
            msg = self.receive_message()
            if msg:
                self.handle_message(msg)
        except (BlockingIOError, Exception):
            pass

    def handle_message(self, msg):
        """Processes server messages and updates the GUI"""
        if msg.startswith('new game,'):
            self.shape = msg.split(',')[1]
            self.clear_gui_board()
            self.statusbar.setText(f"Game Started! You are: {self.shape}")
            self.serveroutput.setText(f"Connected as Player {self.shape}")
           
        elif msg == 'your move': 
            self.statusbar.setText("★ IT'S YOUR TURN! ★")
            self.set_board_enabled(True)
        
        elif msg == 'opponents move':
            self.statusbar.setText("Waiting for opponent...")
            self.set_board_enabled(False)
        
        elif msg == 'invalid move':
            QMessageBox.warning(self, "Invalid Move", "That spot is taken or invalid!")
        
        elif msg.startswith('valid move,'):
            _, shape, pos = msg.split(',')
            r, c = int(pos) // 3, int(pos) % 3
            self.board_buttons[r][c].setText(shape)
            self.board_buttons[r][c].setEnabled(False)
            self.board_buttons[r][c].setStyleSheet("color: #FF3131;" if shape == 'X' else "color: #2323FF;")
        
        elif msg.startswith('game over,'):
            winner = msg.split(',')[1]
            self.set_board_enabled(False)
            result_text = "It's a Tie!" if winner == 'T' else f"Player {winner} Wins!"
            self.statusbar.setText(f"GAME ENDED: {result_text}")
            QMessageBox.information(self, "Game Over", f"The game has ended. {result_text}")
            
        elif msg == 'play again':
            reply = QMessageBox.question(self, 'Play Again?', 'Would you like to play another round?',
                                       QMessageBox.Yes | QMessageBox.No, QMessageBox.Yes)
            if reply == QMessageBox.Yes:
                self.send_message('y')
                self.clear_gui_board()
            else:
                self.send_message('n')
                self.statusbar.setText("Game Finished.")

    # --- BUTTON ACTIONS ---
    def grid_button_clicked(self):
        sender = self.sender()
        for i in range(3):
            for j in range(3):
                if self.board_buttons[i][j] == sender:
                    move_idx = i * 3 + j
                    self.send_message(str(move_idx)) # Sends 0-8 to server

    def connect_button_clicked(self):
        ip = self.enterserver.text() or "127.0.0.1"
        try:
            self.connect_to_server(ip)
            self.network_timer.start(100)
            self.serverbutton.setEnabled(False)
            self.enterserver.setEnabled(False)
            self.statusbar.setText("Connecting...")
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Could not connect to {ip}: {e}")

    def new_game_clicked(self):
        """Resets the UI and requests a fresh game state"""
        self.clear_gui_board()
        self.statusbar.setText("Ready for a New Game. Waiting for opponent...")
        self.serveroutput.setText("Session reset.")

    def restart_clicked(self):
        """Clears the board and prompts the user to reconnect if needed"""
        self.clear_gui_board()
        self.statusbar.setText("Game board cleared.")
        QMessageBox.information(self, "Restart", "Board has been reset. If you were in a game, you may need to reconnect or wait for the server.")

    def clear_gui_board(self):
        for i in range(3):
            for j in range(3):
                self.board_buttons[i][j].setText("")
                self.board_buttons[i][j].setEnabled(False)

    def set_board_enabled(self, status):
        for i in range(3):
            for j in range(3):
                if self.board_buttons[i][j].text() == "":
                    self.board_buttons[i][j].setEnabled(status)

    def show_help_screen(self):
        help_text = (
            "<b>How to Play:</b><br>"
            "1. Enter the Server IP and click 'CONNECT'.<br>"
            "2. Once matched, you will be assigned <b>X</b> or <b>O</b>.<br>"
            "3. Take turns clicking empty squares to place your mark.<br>"
            "4. Get 3 in a row (horizontal, vertical, or diagonal) to win!<br><br>"
            "<b>Controls:</b><br>"
            "- <b>NEW GAME:</b> Starts a fresh session.<br>"
            "- <b>RESTART:</b> Clears your local board.<br>"
            "- <b>SWITCH THEME:</b> Toggles Dark/Light modes."
        )
        QMessageBox.about(self, "Help Guide", help_text)

    def switch_theme(self):
        self.current_theme = "light" if self.current_theme == "dark" else "dark"
        self.apply_theme()

    def apply_theme(self):
        if self.current_theme == "dark":
            bg, text, btn_color = "#002147", "white", "#004488"
            self.closebutton.setStyleSheet("background-color:#aa3333; color:white;")
        else:
            bg, text, btn_color = "#f0f0f0", "#111111", "#d0d0d0"
            self.closebutton.setStyleSheet("background-color:#ff6666; color:black;")
        
        self.setStyleSheet(f"background-color: {bg}; color: {text};")
        self.serveroutput.setStyleSheet(f"background-color: {btn_color}; border: 1px solid gray; padding: 5px;")

if __name__ == "__main__":
    app = QApplication(sys.argv)
    game = TicTacToe()
    game.show()
    sys.exit(app.exec_())
